{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/js/(.*)",
      "headers": {
        "content-type": "application/javascript; charset=utf-8"
      },
      "dest": "/js/$1"
    },
    {
      "src": "/styles.css",
      "headers": {
        "content-type": "text/css; charset=utf-8"
      },
      "dest": "/styles.css"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
